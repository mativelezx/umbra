{
  "name": "umbra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "turbo:dev": "turbo run dev",
    "turbo:build": "turbo run build",
    "turbo:lint": "turbo run lint",
    "turbo:typecheck": "turbo run typecheck",
    "turbo:test": "turbo run test",
    "turbo:test:e2e": "turbo run test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "integrity:check": "node scripts/check-internal-integrity.mjs",
    "agent-os:check": "test -f AGENTS.md && test -f .agent-os/PROJECT_PROFILE.md && test -f pnpm-workspace.yaml && test -f turbo.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@phosphor-icons/react": "^2.1.7",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "framer-motion": "^12.38.0",
    "html2pdf.js": "^0.14.0",
    "next": "15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.25.12",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.25",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14",
    "typescript": "^5.5.4",
    "vite": "6.4.2",
    "vitest": "^4.1.7"
  },
  "workspaces": [
    "."
  ],
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28",
      "sharp": "0.35.4",
      "dompurify": "3.4.15",
      "form-data": "4.0.6",
      "browserslist": "4.28.9",
      "@babel/core": "^7.29.6"
    }
  }
}
