# Copiá este archivo a .env.local y completá con tus keys reales.
# NUNCA commitees .env.local al repo.

# =================================================================
# Supabase (Phase 1)
# =================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =================================================================
# Anthropic (Phase 1 + 1.5)
# =================================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Pinned model SKU (never use aliases in prod — H1 determinism depends on this)
ANTHROPIC_MODEL_ID=claude-sonnet-4-6-20260301

# Secondary model for H2 cross-model paraphrase eval (Phase 3)
ANTHROPIC_HAIKU_MODEL_ID=claude-haiku-4-5-20251001

# =================================================================
# Rate limiting + cost caps (Phase 1.5 + Phase 5)
# =================================================================
DAILY_TOKEN_CAP=400000                   # dynamic onboarding ~13k/turn × 8 + chat + narrative + plan
DAILY_COST_CAP_CENTS=200                 # USD 2.00 per user per day (default del codigo)
GLOBAL_DAILY_BUDGET_USD=50               # parametro declarado; el corte automatico en runtime NO esta implementado (ver docs/tech/RATE_LIMITING.md)
ANTHROPIC_MAX_BUDGET_USD_PER_CI_RUN=5    # reservado: sin uso en el codigo ni en CI (documental)

# =================================================================
# Peppers (Phase 1.5 — Migration 002)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit real values. Rotate on any suspected compromise.
# =================================================================
CONSENT_IP_PEPPER_V1=<32-byte random hex>
CRISIS_PEPPER_V1=<32-byte random hex>
RESEARCH_PEPPER_V1=<32-byte random hex>
DELETE_TOKEN_PEPPER_V1=<32-byte random hex>

# =================================================================
# Email (Phase 2 — delete confirmation magic links + notifications)
# =================================================================
RESEND_API_KEY=your-resend-key
EMAIL_FROM=umbra@yourdomain.com

# =================================================================
# Módulo ML propio (ADR-026)
# Endpoint del componente analítico FastAPI (DistilBERT + Ridge).
# Localmente:  http://localhost:8000  (uvicorn ml.src.api_server:app)
# Producción:  https://umbra-ml.onrender.com  (o el host que uses)
# Si no se setea, lib/ml-client.ts cae al default localhost:8000.
# =================================================================
ML_API_URL=http://localhost:8000

# =================================================================
# Site URL (metadata, sitemap, robots, redirects)
# Sin protocolo trailing slash.
# =================================================================
NEXT_PUBLIC_SITE_URL=https://umbra-sigma.vercel.app
