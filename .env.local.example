# Copiá este archivo a .env.local y completá con tus keys reales.
# NUNCA commitees .env.local al repo.

# =================================================================
# Supabase (Phase 1)
# =================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =================================================================
# Anthropic (Phase 1 + 1.5)
# =================================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Pinned model SKU para la capa narrativa (Pass 1.5 + chat + plan +
# crisis classifier). Nunca usar alias en prod (auditoría narrativa
# depende del SKU dateado).
ANTHROPIC_MODEL_ID=claude-sonnet-4-6-20260301

# Secondary model legacy (rewriter de H2 — H2 deprecada post pivot ML
# 2026-04-27, ADR-020 SUPERSEDED). Conservado por si algún script legacy
# lo lee; no se usa en el flujo principal.
ANTHROPIC_HAIKU_MODEL_ID=claude-haiku-4-5-20251001

# =================================================================
# Módulo ML propio (post-pivot, ADR-026)
# =================================================================
# URL del FastAPI local o desplegado. En desarrollo: localhost:8000.
# En producción: dejar vacío (el backend usa default localhost) o
# apuntar al deploy en Render/Fly.io. La inferencia Big Five va por acá.
ML_API_URL=http://localhost:8000

# Origen del Big Five (default "ml" — módulo ML propio).
# Valores: "ml" | "claude". El modo "claude" es contingencia operativa
# breve si el módulo ML está caído; re-abre la brecha entre código y
# TFG y por eso requiere set explícito (ADR-026).
ANALYZE_BIG_FIVE_SOURCE=ml

# =================================================================
# Rate limiting + cost caps (Phase 1.5 + Phase 5)
# =================================================================
DAILY_TOKEN_CAP=400000                   # dynamic onboarding ~13k/turn × 8 + chat + narrative + plan
DAILY_COST_CAP_CENTS=1500                # USD 15.00 per user per day
GLOBAL_DAILY_BUDGET_USD=50               # hard cap across all users
ANTHROPIC_MAX_BUDGET_USD_PER_CI_RUN=5    # CI eval cost ceiling

# =================================================================
# Peppers (Phase 1.5 — Migration 002)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit real values. Rotate on any suspected compromise.
# =================================================================
CONSENT_IP_PEPPER_V1=<32-byte random hex>
CRISIS_PEPPER_V1=<32-byte random hex>
RESEARCH_PEPPER_V1=<32-byte random hex>
DELETE_TOKEN_PEPPER_V1=<32-byte random hex>

# =================================================================
# Email (Phase 2 — delete confirmation magic links + notifications)
# =================================================================
RESEND_API_KEY=your-resend-key
EMAIL_FROM=umbra@yourdomain.com
